# ==========================================================
# TOPFEROS MD V2.0.0
# GOOGLE GEMINI AI CONFIGURATION
# ==========================================================

# APPLICATION
NODE_ENV=production
BOT_NAME=TOPFEROS MD
BOT_VERSION=2.0.0

# GEMINI API
GEMINI_API_KEY=METE_KLE_API_OU_ISIT
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash

# GOOGLE SEARCH GROUNDING
GEMINI_GOOGLE_SEARCH=true
GEMINI_SHOW_SOURCE_LINKS=false

# AUTOMATIC TRANSLATION
AUTO_TRANSLATION=true
TRANSLATION_PROVIDER=gemini

# LANGUAGE
DEFAULT_LANGUAGE=ht
SUPPORTED_LANGUAGES=ht,fr,en,es,pt,zh

# AI SETTINGS
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048

# ==========================================================
# SECURITY
# Keep your API key private.
# Add production secrets in Render Environment Variables.
# ==========================================================